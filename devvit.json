{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "updateflairmodaction",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Configure Removal Reason Post Flairs",
        "description": "Configure post flairs for custom removal reasons",
        "location": ["subreddit"],
        "forUserType": "moderator",
        "endpoint": "/internal/menu/configure-removal-reason-post-flairs"
      }
    ]
  },
  "forms": {
    "removal-reason-flairs": "/internal/forms/removal-reason-flairs",
    "configuration": "/internal/form/configuration-submit"
  },
  "triggers": {
    "onModAction": "/internal/triggers/on-mod-action"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  },
  "dev": {
    "subreddit": "updateflairmodact_dev"
  },
  "settings": {
    "subreddit": {
      "approveFlairId": {
        "type": "string",
        "label": "Approve post flair ID"
      },
      "removeFlairId": {
        "type": "string",
        "label": "Remove post flair ID",
        "helpText": "Flair assignments for removal reasons can be configured from the subreddit menu."
      },
      "spamFlairId": {
        "type": "string",
        "label": "Spam post flair ID"
      },
      "lockFlairId": {
        "type": "string",
        "label": "Lock post flair ID"
      },
      "ignoreModerators": {
        "type": "string",
        "label": "List of moderators to ignore (comma separated, not case sensitive, u/ is optional)",
        "helpText": "u/flairassistant is always ignored to avoid infinite loops."
      }
    }
  }
}